{
  "name": "@swup/cli",
  "version": "5.0.3",
  "description": "Swup CLI for plugin development and site validation",
  "type": "module",
  "author": {
    "name": "Georgy Marchuk",
    "email": "gmarcuk@gmail.com",
    "url": "https://gmrchk.com/"
  },
  "bin": {
    "swup": "./bin/run.js"
  },
  "homepage": "https://github.com/swup/cli",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": "swup/cli",
  "files": [
    "/bin",
    "/dist",
    "/package-lock.json",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^4.11.4",
    "@oclif/plugin-help": "^6.2.50",
    "@swup/browserslist-config": "^1.0.1",
    "@swup/prettier-config": "^1.1.0",
    "@tsdown/css": "^0.22.2",
    "chalk-template": "^1.1.2",
    "cosmiconfig": "^9.0.2",
    "crawler": "^2.1.0",
    "enquirer": "^2.4.1",
    "lightningcss": "^1.32.0",
    "listr2": "^10.2.1",
    "lodash-es": "^4.18.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "shelljs-live": "^0.0.5",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oclif/test": "^4.1.19",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.3",
    "@types/shelljs": "^0.10.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "oclif": "^4.23.16",
    "shx": "^0.4.0",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "oclif": {
    "bin": "swup",
    "dirname": "swup",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": ":",
    "topics": {
      "package": {
        "description": "Bundle, lint, and develop packages"
      }
    },
    "repositoryPrefix": "<%- repo %>/blob/<%- version %>/<%- commandPath %>"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint .",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "pretest": "npm run build",
    "test": "vitest run",
    "version": "npm run build && oclif readme && git add README.md"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "bugs": "https://github.com/swup/cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts",
  "prettier": "@swup/prettier-config"
}
